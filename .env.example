# Tally Ho boat box — copy to .env and fill in. NEVER commit a filled .env.
# install.sh creates .env from this file on first run and never overwrites it.

# --- Open WebUI -> Ollama on the VM HOST (not in the VM) ---
# Host's Tailscale IP, e.g. http://100.x.y.z:11434
# On the host, Ollama must listen beyond localhost: OLLAMA_HOST=0.0.0.0:11434
# and the host firewall must allow 11434 only from this VM / Tailscale.
OLLAMA_BASE_URL=http://100.x.y.z:11434

# Generated by install.sh on first run if empty.
WEBUI_SECRET_KEY=

# --- Hermes wrappers (systemd units read this file) ---
MQTT_HOST=localhost
# Telegram: from @BotFather, and your chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Open WebUI: profile -> Settings -> Account -> API Keys -> Create new secret key.
# Model must be the exact id from Open WebUI's model dropdown.
OWUI_BASE_URL=http://127.0.0.1:3000
OWUI_API_KEY=
OWUI_MODEL=
OWUI_CHAT_ID=

# --- Notion mirror (pull_notion.py reads this) ---
NOTION_TOKEN=

# Optional: Tailscale auth key for unattended `tailscale up`.
# Leave empty to run `tailscale up` interactively instead.
TAILSCALE_AUTHKEY=
