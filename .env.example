# Tally Ho boat box (Hermes edition) — copy to .env and fill in.
# NEVER commit a filled .env. install.sh creates .env from this file
# on first run and never overwrites it.

# --- Hermes WebUI ---
# Exposed to the local network: any device on the boat LAN can reach
# http://<box-LAN-IP>:8787 (and http://<box-LAN-IP>/ via nginx).
# Password is REQUIRED when bound beyond loopback — without it,
# anyone who can reach the port can run commands as the agent.
# install.sh generates a password if this is left empty; read it
# here, or set your own. Do NOT port-forward 8787 (or 80) to the
# public internet; the box is expected to sit behind a router NAT.
HERMES_WEBUI_HOST=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_PASSWORD=
# Default workspace shown in WebUI on first launch.
HERMES_WEBUI_DEFAULT_WORKSPACE=/opt/tallyho/workspace

# --- Notion mirror (pull_notion.py reads this) ---
NOTION_TOKEN=

# Optional: Tailscale auth key for unattended `tailscale up`.
# Leave empty to run `tailscale up` interactively instead.
TAILSCALE_AUTHKEY=

# --- Notes (not read by any service) ---
# Models are NOT configured here. Run `hermes model` (or `hermes setup`)
# as the service user and pick a provider: cloud, Nous Portal OAuth,
# or host Ollama as a local/custom endpoint (see docs/FIRST_RUN.md).
# Telegram is NOT configured here either. Run `hermes gateway setup`
# as the service user (see docs/TELEGRAM_SETUP.md). The old MQTT
# wrapper variables (TELEGRAM_BOT_TOKEN etc. in a wrapper .env) are gone.
