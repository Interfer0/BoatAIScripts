[Unit]
Description=Hermes -> Telegram wrapper
After=mosquitto.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
EnvironmentFile=/opt/tallyho/.env
ExecStart=/usr/bin/python3 /opt/tallyho/hermes/hermes-telegram-wrapper.py
Restart=always
RestartSec=5
# The wrapper exits if bot_token/chat_id are unset; that is expected
# before first configuration. Fill .env, then: systemctl restart hermes-telegram

[Install]
WantedBy=multi-user.target
