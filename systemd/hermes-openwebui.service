[Unit]
Description=Hermes -> Open WebUI wrapper
After=tallyho-stack.service mosquitto.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
EnvironmentFile=/opt/tallyho/.env
ExecStart=/usr/bin/python3 /opt/tallyho/hermes/hermes-openwebui-wrapper.py
Restart=always
RestartSec=5
# The wrapper exits if owui_api_key/model are unset; that is expected
# before first configuration. Fill .env, then: systemctl restart hermes-openwebui

[Install]
WantedBy=multi-user.target
